{
  "services": {
    "config": {
      "image": "${MONGO_IMAGE:-mongodb/mongodb-community-server:9.0-ubi9}",
      "entrypoint": [
        "mongod"
      ],
      "command": [
        "--configsvr",
        "--port",
        "27017",
        "--replSet",
        "csrs",
        "--bind_ip_all",
        "--wiredTigerCacheSizeGB",
        "0.25"
      ],
      "cpus": 2,
      "mem_limit": "1g",
      "environment": {
        "RS_NAME": "csrs",
        "RS_HOST": "config:27017",
        "RS_CONFIG": "true"
      },
      "volumes": [
        "./scripts:/scripts:ro"
      ]
    },
    "shard0": {
      "image": "${MONGO_IMAGE:-mongodb/mongodb-community-server:9.0-ubi9}",
      "entrypoint": [
        "mongod"
      ],
      "command": [
        "--shardsvr",
        "--port",
        "27017",
        "--replSet",
        "shard0",
        "--bind_ip_all",
        "--wiredTigerCacheSizeGB",
        "0.25"
      ],
      "cpus": 2,
      "mem_limit": "1g",
      "environment": {
        "RS_NAME": "shard0",
        "RS_HOST": "shard0:27017",
        "RS_CONFIG": "false"
      },
      "volumes": [
        "./scripts:/scripts:ro"
      ]
    },
    "shard1": {
      "image": "${MONGO_IMAGE:-mongodb/mongodb-community-server:9.0-ubi9}",
      "entrypoint": [
        "mongod"
      ],
      "command": [
        "--shardsvr",
        "--port",
        "27017",
        "--replSet",
        "shard1",
        "--bind_ip_all",
        "--wiredTigerCacheSizeGB",
        "0.25"
      ],
      "cpus": 2,
      "mem_limit": "1g",
      "environment": {
        "RS_NAME": "shard1",
        "RS_HOST": "shard1:27017",
        "RS_CONFIG": "false"
      },
      "volumes": [
        "./scripts:/scripts:ro"
      ]
    },
    "mongos": {
      "image": "sdk-performance-mongos:local",
      "build": {
        "context": "../..",
        "dockerfile": "e2e-tests/performance/Dockerfile",
        "target": "mongos",
        "args": {
          "MONGO_IMAGE": "${MONGO_IMAGE:-mongodb/mongodb-community-server:9.0-ubi9}"
        }
      },
      "cpus": 2,
      "mem_limit": "1g",
      "command": [
        "--configdb",
        "csrs/config:27017",
        "--bind_ip_all",
        "--setParameter",
        "featureFlagExtensionsAPI=true",
        "--setParameter",
        "featureFlagExtensionsApiSignatureValidation=false",
        "--extensionsConfigPath",
        "/etc/mongo/extensions",
        "--loadExtensions",
        "perf_source,perf_transform"
      ],
      "volumes": [
        "./scripts:/scripts:ro"
      ]
    },
    "driver": {
      "image": "sdk-performance-driver:local",
      "build": {
        "context": "../..",
        "dockerfile": "e2e-tests/performance/Dockerfile",
        "target": "driver",
        "args": {
          "MONGO_IMAGE": "${MONGO_IMAGE:-mongodb/mongodb-community-server:9.0-ubi9}"
        }
      },
      "cpus": 2,
      "mem_limit": "1g",
      "environment": {
        "MONGODB_URI": "mongodb://mongos:27017/",
        "LOAD_TOPOLOGY": "${LOAD_TOPOLOGY}",
        "LOAD_CONCURRENCY": "${LOAD_CONCURRENCY:-1,4,16,64}",
        "LOAD_REQUESTS": "${LOAD_REQUESTS:-8}",
        "LOAD_WARMUP": "${LOAD_WARMUP:-2}",
        "LOAD_TARGET_RPS": "${LOAD_TARGET_RPS:-0}",
        "LOAD_SOAK_SECONDS": "${LOAD_SOAK_SECONDS:-0}",
        "REPORT_DIR": "/reports"
      },
      "volumes": [
        "../../reports/performance/load/${LOAD_TOPOLOGY}:/reports"
      ]
    }
  }
}
