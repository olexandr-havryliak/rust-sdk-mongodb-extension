{
  "connector.class": "io.aiven.kafka.connect.opensearch.OpensearchSinkConnector",
  "tasks.max": "1",
  "topics": "mongodb.search_demo.range,mongodb.search_demo.hashed,mongodb.search_demo.compound,mongodb.search_demo.unsharded",
  "connection.url": "http://opensearch:9200",
  "key.ignore": "false",
  "schema.ignore": "true",
  "index.write.method": "insert",
  "behavior.on.null.values": "delete",
  "behavior.on.version.conflict": "ignore",
  "max.in.flight.requests": "1",
  "batch.size": "1",
  "errors.tolerance": "none",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "transforms": "fields",
  "transforms.fields.type": "org.apache.kafka.connect.transforms.ReplaceField$Value",
  "transforms.fields.include": "description"
}
